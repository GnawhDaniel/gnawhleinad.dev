---
import Head from "../components/Head.astro";
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-MPlus1P" />
    <Head />
  </head>
  <body>
    <slot />
    <hr class="hr" />
    <footer>
      <a href="https://github.com/GnawhDaniel/gnawhleinad.dev">Source Code</a>
    </footer>
  </body>
</html>

<style is:global>
  .hr {
    border: none;
    height: 0.6rem;
    width: 0.6rem;
    background-color: var(--color-primary-text);
    margin-left: 0;
    margin-top: 3rem;
    margin-bottom: 3rem;
    transform: rotate(45deg);
  }

  footer {
    margin-bottom: 2rem;
    font-size: 12px;
  }

  :root {
    --color-bg: rgb(19, 19, 19);
    --color-primary-text: rgb(204, 204, 204);
    --color-secondary-text: rgb(140, 140, 140);
    --font-size-base: 16px;
    --font-size-header: 25px;
    --mobile-breakpoint: 500px; 
  }

  html {
    font-size: var(--font-size-base);
  }

  body {
    font-family: var(--font-MPlus1P);
    background-color: var(--color-bg);
    color: var(--color-primary-text);

    display: flex;
    flex-direction: column;
    margin: auto;

    width: 100%;
    padding: 0 2.5rem;

  }

  @media (width < 500px) {
    p {
      font-size: 0.8rem;
    }

    body {
      padding: 0 1.5rem;
    }
  }

  a,
  a:visited {
    color: rgb(119, 190, 255);
  }
</style>
