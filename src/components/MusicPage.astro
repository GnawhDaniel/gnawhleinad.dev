---
import MusicComponent from "./MusicComponent.astro";
import Header from "./Header.astro";
---

<Header title="Music" />
<main>
  <iframe
    src="https://listenbrainz.org/user/bcore._/embed/playing-now"
    frameborder="0"
    width="650"
    title="Currently listening to"
    height="80"
  >
  </iframe>
  <MusicComponent/>
</main>
<style>
  iframe {
    display: block;
    margin: 0 auto;
    margin-bottom: 3rem;
  }
</style>
