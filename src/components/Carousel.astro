---
import Section from "./Section.astro"

interface Props {
  header: string;
  url?: string;
  linkText?: string;
}

const { header, url = "/", linkText = "All" } = Astro.props;
---

<Section
  header={header}
  url={url}
  linkText={linkText}
/>
<div class="carousel">
  <slot name="media"/>
</div>

<style>
  a {
    font-size: .9em;
  }

  .carousel {
    overflow-x: auto;
    display: flex;
    scroll-behavior: smooth;
    gap: 15px;
    padding: 15px 0;
  }

</style>
