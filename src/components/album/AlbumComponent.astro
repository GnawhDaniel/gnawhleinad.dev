---
import Like from "../Like.astro";
import { getCollection } from "astro:content";
import { formatDateCST } from "../../utils/date";
import { getAllLikes } from "../../utils/db";
import { Image } from "astro:assets";

const album = (await getCollection("album")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const likes = await getAllLikes("album");
---

{
  album.map(async (entry) => {
    return (
      <div id={entry.id} class="card">
        <Image
          src={entry.data.url}
          alt={entry.data.caption}
          inferSize={true}
          class={`album-image ${entry.data.orientation}`}
        />
        <div class="description">
          <p>
            {formatDateCST(entry.data.date, ".", false)} @ {entry.data.location}
          </p>
          <Like
            media="album"
            media_id={entry.id}
            likes={likes[entry.id]}
          />
        </div>
        <div class="caption">{entry.data.caption}</div>
      </div>
    );
  })
}

<style>
  .album-image {
    object-fit: contain;
    margin: auto;
  }

  .portrait {
    max-width: 100%;
    max-height: 700px;
  }

  .landscape {
    height: auto;
    max-width: 1000px;
  }

  @media (width < 1100px) {
    .landscape {
      max-width: 800px;
    }
  }

  @media (width < 900px) {
    .landscape {
      max-width: 600px;
    }
  }

  @media (width < 700px) {
    .portrait {
      max-height: 500px;
    }
    .landscape {
      max-width: 370px;
    }
  }

  .description {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    margin: 0.3rem 0;
  }

  .description p {
    margin: 0;
  }

  .card {
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 4rem;
  }

  video {
    border-radius: 0.25rem;
  }
</style>
