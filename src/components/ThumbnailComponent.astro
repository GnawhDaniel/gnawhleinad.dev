---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
   imagePath: string;
   altText: string;
   width?: number;
   height?: number;
}

const { imagePath, altText, width } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/thumbnails/*.{jpeg,jpg,png,gif}');
---

<Image src={images[imagePath]()} alt={altText} width={width} loading="eager"/>