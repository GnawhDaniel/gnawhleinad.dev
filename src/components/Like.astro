---
interface Props {
  media: string;
  media_id: string;
  likes: number;
}

const { media, media_id, likes } = Astro.props;
---

<span>
  <button class="like-button" data-media={media} data-media-id={media_id}>
    {
      () => {
        if (likes === 0) {
          return "Like?";
        } else {
          return `Like? (${likes})`;
        }
      }
    }
  </button>
</span>

<style>
  span {
    display: inline-flex;
    align-items: center;
  }

  button {
    background: none;
    color: var(--color-secondary-text);
    border: none;
    font-size: 0.8rem;
  }

  button:not(:disabled):hover {
    cursor: pointer;
  }

  @media (width < 500px) {
    button {
      font-size: 0.65rem;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".like-button");

  buttons.forEach(async (button) => {
    const media = button.dataset.media || "";
    const mediaId = button.dataset.mediaId || "";

    // Get Likes count if already liked
    const match = button.innerText.match(/\((\d+)\)/);
    const currentCount = match ? parseInt(match[1], 10) : 0;

    // This localstorage method can technically can allow a user
    // to like ~113,636 items depending on length. Localstorage max limit is 5MB
    if (localStorage.getItem(`liked_${media}_${mediaId}`)) {
      button.disabled = true;
      button.textContent = `Liked! (${currentCount})`;
    }

    button.addEventListener("click", async (event) => {
      localStorage.setItem(`liked_${media}_${mediaId}`, "thank you! <3");

      // Update like counter (server-side)
      const { likes: likes } = await fetch("/api/likes", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ media: media, media_id: mediaId }),
      }).then((r) => r.json());

      button.textContent = `Liked! (${likes})`;
      button.disabled = true;
    });
  });
</script>
