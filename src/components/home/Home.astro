---
import Carousel from "../Carousel.astro";
import { formatDateCST } from "../../utils/date";
import Section from "../Section.astro";
import ThumbnailComponent from "../ThumbnailComponent.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

const recentNote = (await getCollection("notes")).sort(
  (a, b) => b.data.datetime.valueOf() - a.data.datetime.valueOf(),
)[0];

const blogs = (await getCollection("blogs")).sort(
  (a, b) => b.data.datetime.valueOf() - a.data.datetime.valueOf(),
);

const album = (await getCollection("album"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 10);
---

<!-- About Me -->
<header>
  <h1>Daniel Hwang</h1>
  <p id="status"></p>
</header>
<main>
  <div class="about-me">
    <p>
      A dude on internet. Enjoys building and learning tech. Loves digging for
      new music and artists, particularly within the Japanese rock scene.
    </p>
    <p>Lives in the States where the summers are way too hot and humid.</p>
  </div>

  <!-- Links -->
  <nav class="pages">
    <a href="/bookmarks"> Bookmarks </a>
  </nav>
  <nav class="socials">
    <a href="https://github.com/GnawhDaniel"> GitHub </a>
    <a href="https://koito.gnawhleinad.dev"> Scrobbles </a>
    <a href="https://www.youtube.com/@%E3%83%90%E3%82%A4%E3%82%AA%E3%82%B3%E3%82%A2"> YouTube </a>
  </nav>

  <hr class="hr" />

  <Carousel header="Album" url="/album">
    {
      album.map((image) => (
        <a
          slot="media"
          href={`/album#${image.id}`}
          aria-label={`Redirect to album entry from ${formatDateCST(image.data.date)}`}
        >
          <Image
            src={image.data.url}
            alt={image.data.caption}
            inferSize={true}
            class="carousel-album-image"
          />
        </a>
      ))
    }
  </Carousel>

  <hr class="hr" />

  <Carousel header="Music" url="/music">
    <a
      slot="media"
      href="/music#manbop-色恋沙汰は全て作図で解決可能であることの証明"
      aria-label="Redirect to guitar cover of 色恋沙汰は全て作図で解決可能であることの証明"
    >
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/manbop - 色恋沙汰は全て作図で解決可能であることの証明 [Cover].png"
        altText=""
        width={250}
      />
    </a>
    <a
      slot="media"
      href="/music#tobeherox-mycolor"
      aria-label="Redirect to guitar cover of My Color from To Be Hero X"
    >
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/To Be Hero X - My Color [Cover].png"
        altText=""
        width={250}
      />
    </a>
    <a
      slot="media"
      href="/music#springwasoursforthetaking"
      aria-label="Redirect to one of my original songs titled 'spring was ours for the taking'."
    >
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/spring was ours for the taking.png"
        altText=""
        width={250}
      />
    </a>
    <a slot="media" href="/music#lite-ghostdance" aria-label="">
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/lite - ghost dance [Cover].png"
        altText=""
        width={170}
      />
    </a>
    <a slot="media" href="/music#demo3">
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/demo3.png"
        altText=""
        width={141}
      />
    </a>
    <a slot="media" href="/music#tricot-melonsoda">
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/tricot - melon soda [Cover].png"
        altText=""
        width={250}
      />
    </a>
    <a slot="media" href="/music#kessokuband-karakara">
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/kessoku band - karakara [Cover].png"
        altText=""
        width={250}
      />
    </a>
    <a slot="media" href="/music#brandysenki-comingofage">
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/Brandy Senki - Coming of Age Story [Cover].png"
        altText=""
        width={250}
      />
    </a>
    <a slot="media" href="/music#tatsuyamaruyama-tokyobay">
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/Tatsuya Maruyama - Tokyo Bay.png"
        altText=""
        width={250}
      />
    </a>
    <a slot="media" href="/music#song2">
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/song2.png"
        altText=""
        width={250}
      />
    </a>
    <a slot="media" href="/music#song1">
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/song 1.png"
        altText=""
        width={80}
      />
    </a>
    <a slot="media" href="/music#theoralcigarettes-heykids">
      <ThumbnailComponent
        imagePath="/src/assets/thumbnails/THE ORAL CIGARETTES - Kyouran Hey Kids!! [Cover].png"
        altText=""
        width={250}
      />
    </a>
  </Carousel>

  <hr class="hr" />

  <Section header="Notes" url="/notes" linkText="All" />
  <div class="latest-note">
    <p class="note-datetime">
      {formatDateCST(recentNote.data.datetime)}
    </p>
    {
      async () => {
        const { Content } = await render(recentNote);
        return <Content />;
      }
    }
    <div class="note-hashtags">
      {
        recentNote.data.hashtags.map((hashtag) => (
          <p class="hashtag">{hashtag}</p>
        ))
      }
    </div>
  </div>

  <hr class="hr" />

  <Section header="Blogs" url="/blogs" linkText="" />
  <div>
    {
      blogs.map((blog) => (
        <div class="blog-post">
          <a href={`/blogs/${blog.id}`}>
            <p>{blog.data.title}</p>
          </a>
          <p class="note-datetime">{formatDateCST(blog.data.datetime)}</p>
        </div>
      ))
    }
  </div>
</main>

<style>
  .carousel-album-image {
    width: auto;
    height: 225px;
    object-fit: contain;
    max-width: unset;
  }

  video {
    max-width: 400px;
  }

  img {
    max-width: 250px;
    border-radius: 0.2rem;
  }

  .note-datetime {
    font-size: 0.9em;
    color: var(--color-secondary-text);
  }

  .note-hashtags {
    display: flex;
    gap: 0.8em;
    font-size: 12px;
    color: whitesmoke;
  }

  .hr {
    border: none;
    height: 0.6rem;
    width: 0.6rem;
    background-color: var(--color-primary-text);
    margin-left: 0;
    margin-top: 3rem;
    margin-bottom: 3rem;
    transform: rotate(45deg);
  }

  nav {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .blog-post {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 1.15rem;
  }

  .blog-post p {
    margin: 0;
  }
</style>
