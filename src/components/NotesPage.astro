---
import { formatDateCST } from '../utils/date';
import { getCollection, render } from 'astro:content';
import Header from './Header.astro';
import Like from './Like.astro';
import { getAllLikes } from '../utils/db';

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.datetime.valueOf() - a.data.datetime.valueOf(),
);

const likes  = await getAllLikes("notes");

---
<Header title="Notes"/>
<main>
    {notes.map(async (note) => {
      const { Content } = await render(note);
      return (
        <div class="note">
          <div>
            <a href=`/notes/${note.id}` class="note-datetime">{formatDateCST(note.data.datetime)}</a>
            <Like media="notes" media_id={note.id} likes={likes[note.id]} />
          </div>
          <Content />
          <div class="note-hashtags">
            {
              note.data.hashtags.map(hashtag => (
                <p class="hashtag">{hashtag}</p>
              ))
            }
          </div>
        </div>
        <hr/>
      );
    })}
</main>

<style>


  .note {
    display: flex;
    flex-direction: column;
  }

  .note-content {
    margin-left: 1.25em;
  }

  .note-datetime {
    font-size: 0.9em;
    color: var(--color-secondary-text);
  }

  .note-hashtags {
    display: flex;
    gap: 0.8em;
    font-size: 12px;
    color: whitesmoke;
  }

</style>