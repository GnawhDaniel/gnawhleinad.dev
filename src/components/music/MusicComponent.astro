---
import Like from "../Like.astro";
import { getCollection } from "astro:content";
import { formatDateCST } from "../../utils/date";
import { getAllLikes } from "../../utils/db";


const musics = (await getCollection("music")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const likes = await getAllLikes("music");
---

{
  musics.map(async (music) => {
    return (
      <div id={music.id} class="card">
        <video controls>
          <source src={encodeURI(music.data.url)} type="video/mp4" />
        </video>
        <div class="description">
          <p>
            {formatDateCST(music.data.date, ".", false)} //{" "}
            {music.data.artist === "Daniel H" ? "" : `${music.data.artist} - `}
            {music.data.title} ({music.data.type})
          </p>
          <Like media="music" media_id={music.id} likes={likes[music.id]} />
        </div>
      </div>
    );
  })
}

<style>
  video {
    max-height: 650px; 
  }

  @media (width < 500px) {
    video {
      /* max-height: 200px; */
      width: 100%;
    }
  }

  .description {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .card {
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 4rem;
  }

  video {
    border-radius: 0.25rem;
  }
</style>
