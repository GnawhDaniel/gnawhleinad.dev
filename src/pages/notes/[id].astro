---
import { getCollection, render } from "astro:content";
import SpacedLayout from "../../layouts/SpacedLayout.astro";
import { formatDateCST } from "../../utils/date";
import Header from "../../components/Header.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<!-- <h1>{note.data.title}</h1> -->
<SpacedLayout>
  <Header title="Note" url="/notes"/>
  <main>
    <h3 class="note-datetime">{formatDateCST(note.data.datetime)}</h3>
    <Content />
    <div class="note-hashtags">
      {note.data.hashtags.map((hashtag) => <p class="hashtag">{hashtag}</p>)}
    </div>
  </main>
  <style>
    .note-content {
      margin-left: 1.25em;
    }

    .note-datetime {
      font-size: 0.9em;
      color: var(--color-secondary-text);
    }

    .note-hashtags {
      display: flex;
      gap: 0.8em;
      font-size: 12px;
      color: whitesmoke;
    }
  </style>
</SpacedLayout>
