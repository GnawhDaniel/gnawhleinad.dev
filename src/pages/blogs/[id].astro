---
export const prerender = true;

import { getCollection, render } from "astro:content";
import SpacedLayout from "../../layouts/SpacedLayout.astro";
import { formatDateCST } from "../../utils/date";
import Header from "../../components/Header.astro";
import Like from "../../components/Like.astro";
import { getAllLikes } from "../../utils/db";

export async function getStaticPaths() {
  const blogs = await getCollection("blogs");
  return blogs.map((blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

const { blog } = Astro.props;
const { Content } = await render(blog);

const likes  = await getAllLikes("blogs");

---

<SpacedLayout>
  <Header marginBottom="0.1rem" title={blog.data.title} url="/"/>
  <h3 class="blog-datetime">{formatDateCST(blog.data.datetime)}</h3>
  <main>
    <Content />
    <div class="blog-hashtags">
      {blog.data.hashtags.map((hashtag) => <p class="hashtag">{hashtag}</p>)}
    </div>
    <Like media="blogs" media_id={blog.id} likes={likes[blog.id]}/>
  </main>
  <style>
    
    .blog-datetime {
      margin-top: 0;
      font-size: 0.9em;
      color: var(--color-secondary-text);
    }

    .blog-hashtags {
      display: flex;
      gap: 0.8em;
      font-size: 12px;
      color: whitesmoke;
    }
  </style>
</SpacedLayout>
