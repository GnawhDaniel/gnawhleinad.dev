---
import Section from "./Section.astro"
---

<Section
  header="Music"
  url="/music"
  linkText="All"
/>
<div class="carousel">
  <slot name="media"/>
</div>

<style>
  a {
    font-size: .9em;
  }

  .carousel {
    overflow-x: auto;
    display: flex;
    scroll-behavior: smooth;
    gap: 15px;
    padding: 15px 0;
  }

</style>
