---
import { getCollection, render } from 'astro:content';
import { formatDateCST } from '../utils/date';

const posts = await getCollection("notes");
---

<header>
  <h1>Daniel Hwang</h1>
  <h1>Notes</h1>
</header>
<main>
    {posts.map(async (post) => {
      const { Content } = await render(post);
      return (
        <div class="note">
          <p class="note-datetime">{formatDateCST(post.data.datetime)}</p>
          <Content />
          <div class="note-hashtags">
            {
              post.data.hashtags.map(hashtag => (
                <p class="hashtag">{hashtag}</p>
              ))
            }
          </div>
        </div>
        <hr/>
      );
    })}
</main>

<style>
  .note {
    display: flex;
    flex-direction: column;
    margin-bottom: 1em;
  }

  .note-content {
    margin-left: 1.25em;
  }

  .note-datetime {
    font-size: 0.9em;
    color: var(--color-secondary-text);
  }

  .note-hashtags {
    display: flex;
    gap: 0.8em;
    font-size: 12px;
    color: whitesmoke;
  }
</style>


