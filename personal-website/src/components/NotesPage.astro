---
import { formatDateCST } from '../utils/date';
import { getCollection, render } from 'astro:content';
import Header from './Header.astro';

const posts = (await getCollection("notes")).sort(
  (a, b) => b.data.datetime.valueOf() - a.data.datetime.valueOf(),
);
---
<Header title="Notes"/>
<main>
    {posts.map(async (post) => {
      const { Content } = await render(post);
      return (
        <div class="note">
          <a href=`/notes/${post.id}` class="note-datetime">{formatDateCST(post.data.datetime)}</a>
          <Content />
          <div class="note-hashtags">
            {
              post.data.hashtags.map(hashtag => (
                <p class="hashtag">{hashtag}</p>
              ))
            }
          </div>
        </div>
        <hr/>
      );
    })}
</main>

<style>


  .note {
    display: flex;
    flex-direction: column;
  }

  .note-content {
    margin-left: 1.25em;
  }

  .note-datetime {
    font-size: 0.9em;
    color: var(--color-secondary-text);
  }

  .note-hashtags {
    display: flex;
    gap: 0.8em;
    font-size: 12px;
    color: whitesmoke;
  }

</style>