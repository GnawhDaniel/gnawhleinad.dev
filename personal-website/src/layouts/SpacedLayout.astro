---
import Head from "../components/Head.astro";
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-MPlus1P" />
    <Head />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: rgb(19, 19, 19);
    --color-primary-text: rgb(204, 204, 204);
    --font-size-base: 16px;
    --color-secondary-text: rgb(140, 140, 140);
  }

  html,
  body {
    margin: 0;
    font-family: var(--font-MPlus1P);
    font-size: var(--font-size-base);
    background-color: var(--color-bg);
    color: var(--color-primary-text);

    min-width: 40rem;
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    margin: auto;
  }

  a,
  a:visited {
    color: rgb(87, 87, 237);
  }
</style>
